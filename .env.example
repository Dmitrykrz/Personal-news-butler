# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your private chat id with the bot. Leave empty at first: write anything to the bot and it replies with the id.
TELEGRAM_CHAT_ID=
# Long-lived Claude token: run `claude setup-token` and paste the result
CLAUDE_CODE_OAUTH_TOKEN=
# Model alias for all Claude calls
CLAUDE_MODEL=sonnet
# Your timezone (required): schedule times are in it. A tz database name, e.g. Europe/Berlin, America/New_York
TZ=
